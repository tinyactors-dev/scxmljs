#!/usr/bin/env bash
# Release DRY RUN: checks, builds and verifies what would be published, and prints
# the publish command. It never publishes. See scripts/release.ts.
#
#   scripts/release            everything, including the full scripts/ci
#   scripts/release --skip-ci  skip scripts/ci (still builds)
set -euo pipefail
cd "$(dirname "$0")/.."

# bootstrap the toolchain like scripts/ci does, so this also runs on a fresh runner (scripts/publish)
if ! command -v mise >/dev/null 2>&1; then
  printf '\033[1m── installing mise\033[0m\n'
  curl -fsSL https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi
export MISE_YES=1 MISE_TRUSTED_CONFIG_PATHS="$PWD"
mise install bun node

exec mise exec -- bun scripts/release.ts "$@"
