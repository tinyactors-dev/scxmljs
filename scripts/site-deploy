#!/usr/bin/env bash
# Builds https://scxmljs.tinyactors.dev and publishes it to GitHub Pages.
# .github/workflows/site.yml runs exactly this, on a pushed v* tag and on "Run workflow".
#
#   scripts/site-deploy              build, check, force-push _site/ to the gh-pages branch
#   scripts/site-deploy --dry-run    build and check only; nothing is pushed
#
# What gets built: the checked-out commit. The workflow checks out the tag it was triggered by,
# so the site shows the latest release; "Run workflow" builds the branch it's run on (main, or
# pick a tag). Prerelease tags (a version with a "-", e.g. v0.2.0-dev.1) are skipped when the
# trigger is a tag push: the site follows `npm install @tinyactors/scxmljs`, i.e. "latest".
#
# Publishing: _site/ becomes the only commit of the orphan branch gh-pages (force-pushed, so the
# branch never accumulates history). GitHub Pages serves that branch from / with the custom
# domain in _site/CNAME. In GitHub Actions the commit is made as github-actions[bot]; locally
# with your git identity, and only from a clean working tree.
set -euo pipefail
cd "$(dirname "$0")/.."

dry_run=0
case "${1:-}" in
  --dry-run) dry_run=1 ;;
  "") ;;
  -h | --help)
    sed -n '2,/^set /p' scripts/site-deploy | sed '$d;s/^# \{0,1\}//'
    exit 0
    ;;
  *) echo "usage: scripts/site-deploy [--dry-run]" >&2; exit 2 ;;
esac

step() {
  printf '\n\033[1m── %s\033[0m\n' "$1"
}

# ── what to build ───────────────────────────────────────────────────────────
version=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' packages/scxmljs/package.json)
case "${GITHUB_REF:-}" in
  refs/tags/v*)
    tag_version=${GITHUB_REF#refs/tags/v}
    if [ "${GITHUB_EVENT_NAME:-}" = push ] && [[ $tag_version == *-* ]]; then
      echo "v$tag_version is a prerelease: the site follows the latest release, nothing to deploy."
      echo "(Run the workflow by hand on the tag to publish it anyway.)"
      exit 0
    fi
    if [ "$tag_version" != "$version" ]; then
      echo "tag v$tag_version doesn't match packages/scxmljs/package.json ($version)" >&2
      exit 1
    fi
    ;;
esac
commit=$(git rev-parse HEAD)
printf '\033[1msite for @tinyactors/scxmljs %s (%s)\033[0m\n' "$version" "${commit:0:7}"

if [ "$dry_run" = 0 ] && [ "${GITHUB_ACTIONS:-}" != true ] && [ -n "$(git status --porcelain)" ]; then
  echo "uncommitted changes: deploy from a clean working tree (or use --dry-run)" >&2
  git status --short >&2
  exit 1
fi

# ── toolchain (the same bootstrap as scripts/ci) ────────────────────────────
if ! command -v mise >/dev/null 2>&1; then
  step "installing mise"
  curl -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"
export MISE_YES=1 MISE_TRUSTED_CONFIG_PATHS="$PWD"
step "tools (mise install bun node)"
mise install bun node
step "dependencies (bun install)"
mise exec -- bun install --frozen-lockfile

# ── build and check ─────────────────────────────────────────────────────────
step "build (API reference, then the site)"
mise run docs:api
SITE_VERSION=$version mise run site:build
step "check"
mise run site:check

if [ "$dry_run" = 1 ]; then
  printf '\n\033[1;32m✓ built and checked _site/ (dry run: nothing pushed)\033[0m\n'
  exit 0
fi

# ── publish: _site/ as the single commit of gh-pages ───────────────────────
step "publish (force-push gh-pages)"
# a throwaway index over _site/ (git add -f: _site/ is gitignored in this repository)
index=$(mktemp "${TMPDIR:-/tmp}/site-index.XXXXXX")
trap 'rm -f "$index"' EXIT
rm -f "$index"
GIT_INDEX_FILE=$index GIT_WORK_TREE=_site git add -A -f .
tree=$(GIT_INDEX_FILE=$index git write-tree)
if [ "${GITHUB_ACTIONS:-}" = true ]; then
  export GIT_AUTHOR_NAME="github-actions[bot]" GIT_AUTHOR_EMAIL="41898282+github-actions[bot]@users.noreply.github.com"
  export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
fi
site_commit=$(git commit-tree "$tree" -m "site: @tinyactors/scxmljs $version

Built by scripts/site-deploy from $commit.")
git push --force origin "$site_commit:refs/heads/gh-pages"
printf '\n\033[1;32m✓ pushed %s to gh-pages (site for %s from %s)\033[0m\n' "${site_commit:0:7}" "$version" "${commit:0:7}"
